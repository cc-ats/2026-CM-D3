A NVT simulation with SINR thermostat production-level simulations
&cntrl
    imin=0,
    irest=0,
    ntx=1,

    ntb=1,
    ntp=0,

    ntt=12,
    gamma_ln=1.0,
    tempi=10.0,
    temp0=300.0,
    ig=-1,
    nkija=4,
    sinrtau=0.05,

    cut=10.0,

    nstlim=500,
    dt=0.001,

    ntc=1,
    ntf=1,
    tol=0.000001,

    ntpr=100,
    ntwx=100,
    ntwr=500,
    ntxo=2,
    ioutfm=1,

    iwrap=1,

    watnam='WAT',
    owtnm='O',

    nmropt=1,

    ifqnt=1,
/

&ewald
    dsum_tol=0.000001,
/

&qmmm
    qmmask='(:1)',

    qm_theory='EXTERN',
    qmcharge=-2,

    qmshake=0,

    qmcut=999.0,
    qm_ewald=0,
    qm_pme=0,
    qmmm_switch=0,
    writepdb=1,
/

&qmhub
    config="qmhub.ini",
    basedir="",
/

&wt type='DUMPFREQ', istep1=10 /
&wt type='END' /
DISANG=cv.rst
DUMPAVE=step5.01_equilibration.cv